{
  "name": "browser-annotations",
  "version": "0.1.3",
  "private": true,
  "description": "A Chrome DevTools extension to send feedback to your coding agent",
  "homepage": "https://browser-annotations.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiebekaai/browser-annotations.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm run check:types",
    "check:types": "tsgo -b ./tsconfig.json",
    "dev": "vite",
    "package": "vite build && cd dist && zip -r \"../browser-annotations-$npm_package_version.zip\" . -x '.vite/*'"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "clsx": "^2.1.1",
    "solid-js": "1.9.12",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.2.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/chrome": "0.1.38",
    "@types/node": "25.5.0",
    "@typescript/native-preview": "catalog:",
    "tailwindcss": "4.2.2",
    "vite": "^6.3.6",
    "vite-plugin-solid": "2.11.11"
  }
}
